# =============================================================================
# BIẾN MÔI TRƯỜNG KẾT NỐI NEON POSTGRESQL & VERCEL
# =============================================================================

# Chuỗi kết nối Serverless PostgreSQL từ Neon Console (https://console.neon.tech)
# Định dạng: postgresql://[user]:[password]@[endpoint].neon.tech/[dbname]?sslmode=require
DATABASE_URL="postgresql://neondb_owner:your_password_here@ep-sweet-pond-123456.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# Cổng chạy Local (Tùy chọn)
PORT=3000
NODE_ENV=production

# Khóa ký JWT (BẮT BUỘC trên Vercel/production). Tạo bằng: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="doi_thanh_chuoi_ngau_nhien_dai"

# Các origin được phép gọi API từ trình duyệt (phân tách bằng dấu phẩy). Frontend cùng domain Vercel không cần khai báo.
# ALLOWED_ORIGINS="https://ten-mien-cua-ban.com"

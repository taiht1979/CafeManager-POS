{
  "version": 2,
  "name": "cafemanager-pos",
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node"
    },
    {
      "src": "frontend/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.js"
    },
    {
      "src": "/pos",
      "dest": "/frontend/pos.html"
    },
    {
      "src": "/waiter",
      "dest": "/frontend/waiter-order.html"
    },
    {
      "src": "/order",
      "dest": "/frontend/waiter-order.html"
    },
    {
      "src": "/barista",
      "dest": "/frontend/barista.html"
    },
    {
      "src": "/store-admin",
      "dest": "/frontend/store-admin-dashboard.html"
    },
    {
      "src": "/super-admin",
      "dest": "/frontend/super-admin-dashboard.html"
    },
    {
      "src": "/css/(.*)",
      "dest": "/frontend/css/$1"
    },
    {
      "src": "/js/(.*)",
      "dest": "/frontend/js/$1"
    },
    {
      "src": "/(.*\\.(html|css|js|png|jpg|jpeg|svg|webp|ico|json))",
      "dest": "/frontend/$1"
    },
    {
      "src": "/",
      "dest": "/frontend/index.html"
    }
  ]
}
